    "custom_liquid_RYJKJi": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<div class=\"kc-gallery\" id=\"kc-gallery\">\n  <div class=\"kc-gallery-track\">\n\n    <a class=\"kc-gallery-slide\" href=\"https://keshavclothing.com/products/classic-india-wine\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0763/8758/2109/files/Minimalist_Full-Body_Streetwear_Portrait.png?v=1791634283\"\n           alt=\"Classic India Wine\" loading=\"eager\">\n    </a>\n\n    <a class=\"kc-gallery-slide\" href=\"https://keshavclothing.com/products/urban-nomad\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0763/8758/2109/files/ChatGPT_Image_Oct_9_2026_04_55_24_PM-2.png?v=1791634261\"\n           alt=\"Urban Nomad\" loading=\"lazy\">\n    </a>\n\n    <a class=\"kc-gallery-slide\" href=\"https://keshavclothing.com/products/flyhigh-street-navy\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0763/8758/2109/files/ChatGPT_Image_Oct_9_2026_04_55_26_PM-3.png?v=1791634239\"\n           alt=\"Flyhigh Street Navy\" loading=\"lazy\">\n    </a>\n\n    <a class=\"kc-gallery-slide\" href=\"https://keshavclothing.com/products/break-the-rules-pista\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0763/8758/2109/files/ChatGPT_Image_Oct_9_2026_04_55_23_PM-1.png?v=1791634214\"\n           alt=\"Break the Rules Pista\" loading=\"lazy\">\n    </a>\n\n  </div>\n\n  <button type=\"button\" class=\"kc-gallery-arrow kc-gallery-prev\" aria-label=\"Previous image\">\n    &#10094;\n  </button>\n\n  <button type=\"button\" class=\"kc-gallery-arrow kc-gallery-next\" aria-label=\"Next image\">\n    &#10095;\n  </button>\n\n  <div class=\"kc-gallery-dots\">\n    <button type=\"button\" class=\"kc-gallery-dot active\" aria-label=\"Go to image 1\"></button>\n    <button type=\"button\" class=\"kc-gallery-dot\" aria-label=\"Go to image 2\"></button>\n    <button type=\"button\" class=\"kc-gallery-dot\" aria-label=\"Go to image 3\"></button>\n    <button type=\"button\" class=\"kc-gallery-dot\" aria-label=\"Go to image 4\"></button>\n  </div>\n</div>\n\n<style>\n  /* Main gallery */\n  #kc-gallery {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    background: #fff;\n    box-sizing: border-box;\n  }\n\n  #kc-gallery * {\n    box-sizing: border-box;\n  }\n\n  /* Desktop: all four images */\n  #kc-gallery .kc-gallery-track {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 10px;\n    width: 100%;\n  }\n\n  #kc-gallery .kc-gallery-slide {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    min-width: 0;\n    overflow: hidden;\n    background: #fff;\n  }\n\n  #kc-gallery .kc-gallery-slide img {\n    display: block;\n    width: 100%;\n    height: auto;\n    max-width: 100%;\n    object-fit: contain;\n    object-position: center;\n  }\n\n  /* Hide mobile navigation on desktop */\n  #kc-gallery .kc-gallery-arrow,\n  #kc-gallery .kc-gallery-dots {\n    display: none;\n  }\n\n  /* Mobile slider */\n  @media screen and (max-width: 749px) {\n    #kc-gallery {\n      width: 100%;\n      overflow: hidden;\n    }\n\n    #kc-gallery .kc-gallery-track {\n      display: flex;\n      gap: 0;\n      width: 100%;\n      transition: transform 0.35s ease;\n      touch-action: pan-y;\n    }\n\n    #kc-gallery .kc-gallery-slide {\n      flex: 0 0 100%;\n      width: 100%;\n      min-width: 100%;\n      overflow: visible;\n    }\n\n    #kc-gallery .kc-gallery-slide img {\n      display: block;\n      width: 100%;\n      height: auto;\n      max-width: 100%;\n      object-fit: contain;\n      object-position: center;\n    }\n\n    /* Navigation positioned over the image */\n    #kc-gallery .kc-gallery-arrow {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      z-index: 5;\n      width: 36px;\n      height: 36px;\n      padding: 0;\n      border: none;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.88);\n      color: #111;\n      font-size: 17px;\n      line-height: 1;\n      cursor: pointer;\n    }\n\n    #kc-gallery .kc-gallery-prev {\n      left: 10px;\n    }\n\n    #kc-gallery .kc-gallery-next {\n      right: 10px;\n    }\n\n    /* Dots over the bottom of the image */\n    #kc-gallery .kc-gallery-dots {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      position: absolute;\n      z-index: 5;\n      bottom: 12px;\n      left: 50%;\n      transform: translateX(-50%);\n    }\n\n    #kc-gallery .kc-gallery-dot {\n      width: 7px;\n      height: 7px;\n      min-width: 7px;\n      padding: 0;\n      border: none;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.7);\n      box-shadow: 0 0 2px rgba(0, 0, 0, 0.5);\n      cursor: pointer;\n    }\n\n    #kc-gallery .kc-gallery-dot.active {\n      background: #111;\n      outline: 1px solid #fff;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  const gallery = document.getElementById('kc-gallery');\n  if (!gallery || gallery.dataset.ready === 'true') return;\n  gallery.dataset.ready = 'true';\n\n  const track = gallery.querySelector('.kc-gallery-track');\n  const slides = Array.from(gallery.querySelectorAll('.kc-gallery-slide'));\n  const dots = Array.from(gallery.querySelectorAll('.kc-gallery-dot'));\n  const prev = gallery.querySelector('.kc-gallery-prev');\n  const next = gallery.querySelector('.kc-gallery-next');\n\n  let current = 0;\n  let startX = 0;\n  let endX = 0;\n\n  function mobile() {\n    return window.matchMedia('(max-width: 749px)').matches;\n  }\n\n  function render() {\n    if (mobile()) {\n      track.style.transform =\n        'translateX(-' + (current * 100) + '%)';\n    } else {\n      track.style.transform = 'none';\n    }\n\n    dots.forEach(function (dot, i) {\n      dot.classList.toggle('active', i === current);\n      dot.setAttribute('aria-current', i === current ? 'true' : 'false');\n    });\n\n    prev.style.display = mobile() ? 'flex' : 'none';\n    next.style.display = mobile() ? 'flex' : 'none';\n  }\n\n  function goTo(index) {\n    current = (index + slides.length) % slides.length;\n    render();\n  }\n\n  prev.addEventListener('click', function () {\n    goTo(current - 1);\n  });\n\n  next.addEventListener('click', function () {\n    goTo(current + 1);\n  });\n\n  dots.forEach(function (dot, i) {\n    dot.addEventListener('click', function () {\n      goTo(i);\n    });\n  });\n\n  gallery.addEventListener('touchstart', function (event) {\n    if (!mobile()) return;\n    startX = event.touches[0].clientX;\n    endX = startX;\n  }, { passive: true });\n\n  gallery.addEventListener('touchmove', function (event) {\n    if (!mobile()) return;\n    endX = event.touches[0].clientX;\n  }, { passive: true });\n\n  gallery.addEventListener('touchend', function () {\n    const distance = endX - startX;\n\n    if (mobile() && Math.abs(distance) > 45) {\n      goTo(current + (distance < 0 ? 1 : -1));\n    }\n\n    startX = 0;\n    endX = 0;\n  });\n\n  window.addEventListener('resize', render);\n  render();\n})();\n</script>"
      }
