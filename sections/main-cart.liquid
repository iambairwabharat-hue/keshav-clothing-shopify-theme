<section class="cart-section" style="max-width: var(--container-max); margin: 40px auto 80px; padding: 0 var(--container-padding);">
  <h1 class="product-title" style="margin-bottom: 32px;">{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div style="border-top: 1px solid var(--color-gray-200); border-bottom: 1px solid var(--color-gray-200); padding: 24px 0;">
        {%- for item in cart.items -%}
          <div style="display: grid; grid-template-columns: 100px 1fr auto auto; gap: 24px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--color-gray-100);">
            <div style="width: 100px; height: 120px; background: var(--color-gray-100);">
              {%- if item.image -%}
                {%- if item.image != blank -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=200" alt="Garment" style="width: 100%; height: 100%; object-fit: cover;">
            {%- endif -%}
              {%- endif -%}
            </div>
            <div>
              <h3 style="font-size: 15px; font-weight: 600; margin-bottom: 6px;"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              {%- unless item.product.has_only_default_variant -%}
                <p style="font-size: 13px; color: var(--color-gray-500); margin-bottom: 4px;">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p style="font-size: 14px; font-weight: 500;">{{ item.final_price | money }}</p>
            </div>
            <div>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 8px; border: 1px solid var(--color-gray-300); text-align: center;">
            </div>
            <div style="text-align: right;">
              <p style="font-size: 16px; font-weight: 700;">{{ item.final_line_price | money }}</p>
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size: 12px; color: var(--color-gray-500); text-decoration: underline;">Remove</a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 32px;">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline-dark">&larr; Continue Shopping</a>
        <div style="text-align: right; max-width: 360px;">
          <p style="font-size: 14px; color: var(--color-gray-500); margin-bottom: 8px;">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
          <div style="font-size: 24px; font-weight: 700; margin-bottom: 24px;">
            <span>{{ 'sections.cart.subtotal' | t }}:</span> {{ cart.total_price | money }}
          </div>
          <button type="submit" name="checkout" class="btn btn--primary" style="width: 100%; padding: 18px;">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div style="text-align: center; padding: 80px 0;">
      <p style="font-size: 18px; color: var(--color-gray-500); margin-bottom: 24px;">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Explore Collection</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart Page"
}
{% endschema %}
