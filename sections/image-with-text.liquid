{%- comment -%}
  KCCLOTHING - Flagship Image with Text with Custom Height, Desktop Ratios, Mobile Reordering, and Padding
{%- endcomment -%}

{%- style -%}
  #image-with-text-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top_desktop }}px;
    --section-pb: {{ section.settings.padding_bottom_desktop }}px;
    --section-pt-mob: {{ section.settings.padding_top_mobile }}px;
    --section-pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --bg-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --text-color: {{ section.settings.text_color | default: '#171717' }};
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  @media (max-width: 768px) {
    #image-with-text-{{ section.id }} {
      padding-top: var(--section-pt-mob);
      padding-bottom: var(--section-pb-mob);
    }
  }

  /* Desktop Height calculation */
  {%- case section.settings.height -%}
    {%- when 'small' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: 440px; }
    {%- when 'medium' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: 560px; }
    {%- when 'large' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: 680px; }
    {%- when '70vh' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: 70vh; }
    {%- when '85vh' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: 85vh; }
    {%- when 'auto' -%}
      #image-with-text-{{ section.id }} .mv-image { min-height: auto; }
  {%- endcase -%}

  /* Desktop Column Ratio */
  {%- case section.settings.desktop_ratio -%}
    {%- when '50_50' -%}
      #image-with-text-{{ section.id }} .mv-content { grid-template-columns: 1fr 1fr; }
    {%- when '60_40' -%}
      #image-with-text-{{ section.id }} .mv-content { grid-template-columns: 1.2fr 0.8fr; }
    {%- when '40_60' -%}
      #image-with-text-{{ section.id }} .mv-content { grid-template-columns: 0.8fr 1.2fr; }
  {%- endcase -%}

  #image-with-text-{{ section.id }} .mv-image img {
    border-radius: {{ section.settings.image_border_radius }}px;
  }
{%- endstyle -%}

<section class="mission-vision{% if section.settings.layout == 'image_second' %} mission-vision--reversed{% endif %}{% if section.settings.mobile_order == 'text_first' %} mission-vision--mob-text-first{% endif %}{% if section.settings.full_width %} mission-vision--full-width{% else %} container{% endif %}" id="image-with-text-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="mv-content">
    
    <!-- Text Column -->
    <div class="mv-text scroll-reveal mv-text--align-{{ section.settings.text_alignment | default: 'left' }}">
      {%- if section.settings.subheading != blank -%}
        <span class="section-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="mv-text__label">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="mv-text__body rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero-btn hero-btn--{{ section.settings.button_style | default: 'solid_black' }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <span>→</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Image Column -->
    <div class="mv-image">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="mv-image__img"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "header",
      "content": "Media & Sizing"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section Height",
      "options": [
        { "value": "auto", "label": "Auto / Adapt to Content" },
        { "value": "small", "label": "Compact (440px)" },
        { "value": "medium", "label": "Medium (560px)" },
        { "value": "large", "label": "Large (680px)" },
        { "value": "70vh", "label": "70% Screen Height (70vh)" },
        { "value": "85vh", "label": "85% Screen Height (85vh)" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout & Ratios"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image Left / Text Right" },
        { "value": "image_second", "label": "Text Left / Image Right" }
      ],
      "default": "image_second",
      "label": "Desktop Image Placement"
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "options": [
        { "value": "50_50", "label": "Equal Split (50% / 50%)" },
        { "value": "60_40", "label": "Prominent Text (60% / 40%)" },
        { "value": "40_60", "label": "Prominent Image (40% / 60%)" }
      ],
      "default": "50_50",
      "label": "Desktop Column Width Ratio"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "options": [
        { "value": "image_first", "label": "Image on Top" },
        { "value": "text_first", "label": "Text on Top" }
      ],
      "default": "image_first",
      "label": "Mobile Stacking Order"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width (Edge-to-edge)",
      "default": false
    },
    {
      "type": "header",
      "content": "Text Content & Alignment"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR MISSION"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>To create uncompromising garments that dismantle fast-fashion cycles. We engineer timeless, heavyweight staples made to outlive trends.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Text Alignment"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "DISCOVER CRAFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        { "value": "solid_black", "label": "Solid Black" },
        { "value": "solid_white", "label": "Solid White" },
        { "value": "outline_black", "label": "Outline Black" },
        { "value": "outline_white", "label": "Outline White" },
        { "value": "glass", "label": "Glassmorphism" }
      ],
      "default": "solid_black",
      "label": "Button Style"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
