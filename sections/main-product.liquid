<section class="product-main" data-section-id="{{ section.id }}">
  <!-- Product Gallery -->
  <div class="product-gallery product-gallery--{{ section.settings.gallery_layout }}">
    {%- if section.settings.gallery_layout == 'stacked' or section.settings.gallery_layout == 'grid' -%}
      <div class="gallery-expanded-wrapper">
        {%- for media in product.media -%}
          <div class="gallery-expanded-item">
            <img src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" class="gallery-main__image" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            <button type="button" class="gallery-zoom" aria-label="Zoom Image">{% render 'icon', icon: 'search' %}</button>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if product.media.size > 1 -%}
        <div class="gallery-thumbs" id="gallery-thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="gallery-thumb{% if forloop.first %} gallery-thumb--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              data-src="{{ media | image_url: width: 1200 }}"
              aria-label="Thumbnail {{ forloop.index }}"
            >
              <img
                src="{{ media | image_url: width: 150 }}"
                alt="{{ media.alt | escape }}"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
  
      <div class="gallery-main">
        {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- if featured_media != blank -%}
          <img
            src="{{ featured_media | image_url: width: 1200 }}"
            alt="{{ featured_media.alt | escape }}"
            class="gallery-main__image"
            id="gallery-main-img"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'gallery-main__image placeholder-svg' }}
        {%- endif -%}
  
        <button type="button" class="gallery-zoom" aria-label="Zoom Image">
          {% render 'icon', icon: 'search' %}
        </button>
      </div>
    {%- endif -%}
  </div>

  <!-- Product Info & Form -->
  <div class="product-info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'badge' -%}
          <span class="product-badge" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>

        {%- when 'title' -%}
          <h1 class="product-title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

        {%- when 'rating' -%}
          <div class="product-rating" {{ block.shopify_attributes }}>
            <!-- Judge.me app block will go here -->
          </div>

        {%- when 'price' -%}
          <div class="price-block" {{ block.shopify_attributes }}>
            {%- assign selected_variant = product.selected_or_first_available_variant -%}
            <span class="price-current" id="product-price-current">{{ selected_variant.price | money }}</span>
            <span class="price-compare{% unless selected_variant.compare_at_price > selected_variant.price %} is-hidden{% endunless %}" id="product-price-compare">
              {%- if selected_variant.compare_at_price > selected_variant.price -%}
                {{ selected_variant.compare_at_price | money }}
              {%- endif -%}
            </span>
            <span class="price-discount{% unless selected_variant.compare_at_price > selected_variant.price %} is-hidden{% endunless %}" id="product-price-discount">
              {%- if selected_variant.compare_at_price > selected_variant.price -%}
                {%- assign discount = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price -%}
                {{ discount }}% OFF
              {%- endif -%}
            </span>
          </div>

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants" id="product-variants" {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                <div class="variant-group" data-option-index="{{ option_index }}" data-option-name="{{ option.name | escape }}">
                  <div class="variant-label">
                    <span class="variant-label__text">
                      {{ option.name }}: <span class="variant-label__value" id="option-{{ option_index }}-label">{{ option.selected_value }}</span>
                    </span>
                    
                  </div>

                  {%- assign is_color = false -%}
                  {%- assign downcase_option = option.name | downcase -%}
                  {%- if downcase_option contains 'color' or downcase_option contains 'colour' -%}
                    {%- assign is_color = true -%}
                  {%- endif -%}

                  {%- if is_color -%}
                    <div class="color-swatches">
                      {%- for value in option.values -%}
                        {%- assign swatch_bg = '' -%}
                        {%- if value.swatch.image -%}
                          {%- assign swatch_img = value.swatch.image | image_url: width: 100 -%}
                          {%- assign swatch_bg = 'background-image: url(' | append: swatch_img | append: '); background-size: cover;' -%}
                        {%- elsif value.swatch.color -%}
                          {%- assign swatch_bg = 'background-color: ' | append: value.swatch.color | append: ';' -%}
                        {%- else -%}
                          {%- assign val_handle = value | handleize -%}
                          {%- case val_handle -%}
                            {%- when 'black' -%}
                              {%- assign swatch_bg = 'background-color: #000000;' -%}
                            {%- when 'white' -%}
                              {%- assign swatch_bg = 'background-color: #ffffff; border: 1px solid #d4d4d4;' -%}
                            {%- when 'sage-green' or 'sage' or 'sagegreen' -%}
                              {%- assign swatch_bg = 'background-color: #8A9A86;' -%}
                            {%- when 'terracotta' or 'terra-cotta' -%}
                              {%- assign swatch_bg = 'background-color: #C86D51;' -%}
                            {%- when 'binge' or 'beige' -%}
                              {%- assign swatch_bg = 'background-color: #E6D7C3;' -%}
                            {%- when 'cream' or 'creme' -%}
                              {%- assign swatch_bg = 'background-color: #FFFDD0; border: 1px solid #d4d4d4;' -%}
                            {%- when 'gray' or 'grey' -%}
                              {%- assign swatch_bg = 'background-color: #808080;' -%}
                            {%- when 'rosewood' -%}
                              {%- assign swatch_bg = 'background-color: #65000B;' -%}
                            {%- when 'navy' or 'navy-blue' -%}
                              {%- assign swatch_bg = 'background-color: #000080;' -%}
                            {%- when 'red' -%}
                              {%- assign swatch_bg = 'background-color: #FF0000;' -%}
                            {%- when 'orange' -%}
                              {%- assign swatch_bg = 'background-color: #FFA500;' -%}
                            {%- when 'yellow' -%}
                              {%- assign swatch_bg = 'background-color: #FFFF00;' -%}
                            {%- when 'purple' -%}
                              {%- assign swatch_bg = 'background-color: #800080;' -%}
                            {%- when 'lavender' -%}
                              {%- assign swatch_bg = 'background-color: #E6E6FA;' -%}
                            {%- when 'marin-blue' or 'marine-blue' or 'marinblue' -%}
                              {%- assign swatch_bg = 'background-color: #0047AB;' -%}
                            {%- when 'off-white' or 'offwhite' -%}
                              {%- assign swatch_bg = 'background-color: #FAF9F6; border: 1px solid #d4d4d4;' -%}
                            {%- when 'charcoal' -%}
                              {%- assign swatch_bg = 'background-color: #36454F;' -%}
                            {%- when 'olive' or 'olive-green' -%}
                              {%- assign swatch_bg = 'background-color: #556B2F;' -%}
                            {%- when 'khaki' -%}
                              {%- assign swatch_bg = 'background-color: #C3B091;' -%}
                            {%- when 'wine' or 'burgundy' or 'maroon' -%}
                              {%- assign swatch_bg = 'background-color: #800020;' -%}
                            {%- when 'rust' -%}
                              {%- assign swatch_bg = 'background-color: #B7410E;' -%}
                            {%- when 'mustard' -%}
                              {%- assign swatch_bg = 'background-color: #FFDB58;' -%}
                            {%- when 'camel' -%}
                              {%- assign swatch_bg = 'background-color: #C19A6B;' -%}
                            {%- when 'peach' -%}
                              {%- assign swatch_bg = 'background-color: #FFDAB9;' -%}
                            {%- when 'mocha' or 'coffee' or 'brown' -%}
                              {%- assign swatch_bg = 'background-color: #4A2E2B;' -%}
                            {%- when 'denim' or 'indigo' -%}
                              {%- assign swatch_bg = 'background-color: #3F51B5;' -%}
                            {%- when 'sand' or 'nude' or 'tan' -%}
                              {%- assign swatch_bg = 'background-color: #D2B48C;' -%}
                            {%- when 'coral' -%}
                              {%- assign swatch_bg = 'background-color: #FF7F50;' -%}
                            {%- when 'teal' -%}
                              {%- assign swatch_bg = 'background-color: #008080;' -%}
                            {%- when 'emerald' or 'forest-green' -%}
                              {%- assign swatch_bg = 'background-color: #228B22;' -%}
                            {%- when 'sky-blue' -%}
                              {%- assign swatch_bg = 'background-color: #87CEEB;' -%}
                            {%- when 'baby-pink' or 'pink' -%}
                              {%- assign swatch_bg = 'background-color: #FFC0CB;' -%}
                            {%- else -%}
                              {%- assign matched_variant = nil -%}
                              {%- for v in product.variants -%}
                                {%- if v.options contains value and v.featured_media != blank -%}
                                  {%- assign matched_variant = v -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                              {%- if matched_variant != nil -%}
                                {%- assign v_img = matched_variant.featured_media | image_url: width: 100 -%}
                                {%- assign swatch_bg = 'background-image: url(' | append: v_img | append: '); background-size: cover; background-position: center;' -%}
                              {%- else -%}
                                {%- assign swatch_bg = 'background-color: ' | append: val_handle | append: ';' -%}
                              {%- endif -%}
                          {%- endcase -%}
                        {%- endif -%}

                        <button
                          type="button"
                          class="color-swatch variant-option-btn{% if option.selected_value == value %} color-swatch--active is-active{% endif %}"
                          data-value="{{ value | escape }}"
                          data-option-index="{{ option_index }}"
                          style="{{ swatch_bg }}"
                          aria-label="{{ value | escape }}"
                          title="{{ value | escape }}"
                        ></button>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="size-options">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="size-btn variant-option-btn{% if option.selected_value == value %} size-btn--active is-active{% endif %}"
                          data-value="{{ value | escape }}"
                          data-option-index="{{ option_index }}"
                        >{{ value }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

        {%- when 'buy_buttons' -%}
          <div class="buy-buttons-block" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
              <input type="hidden" name="id" id="selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

              <div class="add-to-cart-row">
                <button
                  type="submit"
                  name="add"
                  class="btn-add-to-cart"
                  id="add-to-cart"
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                >
                  {% render 'icon', icon: 'cart' %}
                  <span id="add-to-cart-text">
                    {%- if product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                    {%- endif -%}
                  </span>
                </button>

                <button type="button" class="btn-wishlist" id="wishlist-btn" data-wishlist-toggle="{{ product.id }}" aria-label="Add to wishlist" onclick="if(window.Wishlist){Wishlist.toggle('{{ product.id }}');}event.preventDefault();event.stopPropagation();">
                  {% render 'icon', icon: 'heart' %}
                </button>
              </div>

                            {%- if block.settings.show_dynamic_checkout -%}
                <div class="dynamic-checkout-wrap">
                  <button type="button" class="btn-buy-now" id="buy-now-btn" onclick="window.handleDirectCheckout(event);">
                    <span>BUY NOW</span>
                    <span>→</span>
                  </button>
                  <div class="shopify-payment-btn-wrapper" style="display: none;">
                    {{ form | payment_button }}
                  </div>
                </div>
              {%- endif -%}
            {%- endform -%}

            <!-- Dynamic Estimated Delivery Calculator -->
            <div class="delivery-estimator-box" id="delivery-estimator-box">
              <div class="delivery-estimator-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.8" fill="none"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <div class="delivery-estimator-content">
                <div class="delivery-estimator-main">
                  Estimated Delivery by <strong id="pdp-delivery-date">Express Delivery (3-5 Days)</strong>
                </div>
                <div class="delivery-estimator-sub">
                  ⚡ Order within <span id="pdp-countdown-timer" style="font-weight:700; color:#16a34a;">04 hrs 32 mins</span> for priority dispatch today
                </div>
              </div>
            </div>
          </div>

        {%- when 'model_specs' -%}
          <div class="model-specs-card" {{ block.shopify_attributes }}>
            <div class="model-specs-header">
              <span class="model-specs-tag">FIT & SIZING SPECS</span>
              <span class="model-specs-text">{{ block.settings.model_info | default: 'Model is 6’1” (185 cm) / 175 lbs wearing Size L' }}</span>
            </div>
            <!-- Interactive Fit Spectrum Gauge -->
            <div class="fit-gauge">
              <div class="fit-gauge-labels">
                <span class="fit-gauge-label">Slim</span>
                <span class="fit-gauge-label">Regular</span>
                <span class="fit-gauge-label">Relaxed</span>
                <span class="fit-gauge-label fit-gauge-label--active">Boxy / Oversized</span>
              </div>
              <div class="fit-gauge-track">
                <div class="fit-gauge-fill" style="width: 85%;"></div>
                <div class="fit-gauge-pointer" style="left: 85%;"></div>
              </div>
            </div>
          </div>

        {%- when 'trust_badges' -%}
          <div class="trust-badges" {{ block.shopify_attributes }}>
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <div>
                <div class="trust-badge__text">Free Shipping</div>
                <div class="trust-badge__sub">On orders over Rs. 9900</div>
              </div>
            </div>
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              </div>
              <div>
                <div class="trust-badge__text">Easy Returns</div>
                <div class="trust-badge__sub">15-day exchange policy</div>
              </div>
            </div>
            <div class="trust-badge">
              <div class="trust-badge__icon">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <div class="trust-badge__text">Secure Payment</div>
                <div class="trust-badge__sub">100% encrypted checkout</div>
              </div>
            </div>
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <!-- Back in Stock / Restock Notification Modal -->
  <div class="restock-modal-backdrop" id="restock-modal-backdrop" style="display: none;">
    <div class="restock-modal" id="restock-modal">
      <button type="button" class="restock-modal-close" id="restock-modal-close" aria-label="Close modal">&times;</button>
      <div class="restock-modal-icon">
        <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="1.5" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      </div>
      <h3 class="restock-modal-title">Notify When Restocked</h3>
      <p class="restock-modal-desc">Be the first to know when <strong><span id="restock-product-name">{{ product.title }}</span> (<span id="restock-variant-name">Selected Size</span>)</strong> drops back into stock.</p>
      
      <form class="restock-form" id="restock-form" onsubmit="event.preventDefault(); window.handleRestockSubmit(this);">
        <input type="email" name="email" class="restock-input" placeholder="Enter your email address" required>
        <button type="submit" class="restock-submit-btn">
          <span>Join VIP Restock Waitlist</span>
          <span>→</span>
        </button>
      </form>
      <div class="restock-success-msg" id="restock-success-msg" style="display: none;">
        ✓ You're on the list! We'll alert you the moment this piece is back in stock.
      </div>
    </div>
  </div>

  <!-- Sticky Mobile Add-to-Bag Bottom Bar -->
  <div class="sticky-mobile-atc-bar" id="sticky-mobile-atc-bar">
    <div class="sticky-mobile-atc-info">
      <div class="sticky-mobile-atc-title">{{ product.title }}</div>
      <div class="sticky-mobile-atc-price" id="sticky-mobile-atc-price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
    <button type="button" class="btn-sticky-mobile-atc" id="btn-sticky-mobile-atc">
      <span>ADD TO BAG</span>
      <span>→</span>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New Arrival"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "model_specs",
      "name": "Model & Fit Specs",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "model_info",
          "label": "Model Dimensions Info",
          "default": "Model is 6\u20191\u201d (185 cm) / 175 lbs wearing Size Large"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges",
      "limit": 1
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery Layout",
      "options": [
        {
          "value": "thumbnails_left",
          "label": "Thumbnails Left"
        },
        {
          "value": "thumbnails_bottom",
          "label": "Thumbnails Bottom"
        },
        {
          "value": "stacked",
          "label": "Stacked (1 per row)"
        },
        {
          "value": "grid",
          "label": "Grid (2 per row)"
        }
      ],
      "default": "thumbnails_left"
    }
  ]
}
{% endschema %}
