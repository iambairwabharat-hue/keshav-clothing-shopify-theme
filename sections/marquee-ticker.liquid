{%- style -%}
  #marquee-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top_desktop }}px;
    --section-pb: {{ section.settings.padding_bottom_desktop }}px;
    --section-pt-mob: {{ section.settings.padding_top_mobile }}px;
    --section-pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --bg-color: {{ section.settings.bg_color | default: '#000000' }};
    --text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  @media (max-width: 768px) {
    #marquee-{{ section.id }} {
      padding-top: var(--section-pt-mob);
      padding-bottom: var(--section-pb-mob);
    }
  }

  #marquee-{{ section.id }} .marquee-track {
    animation-duration: {{ section.settings.speed | default: 20 }}s;
    font-size: {{ section.settings.font_size | default: 18 }}px;
  }
{%- endstyle -%}

<section class="marquee-ticker" id="marquee-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="marquee-track">
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <span class="marquee-item" {{ block.shopify_attributes }}>
          <span class="marquee-dot">✦</span>
          <span>{{ block.settings.text | escape }}</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee Ticker",
  "settings": [
    { "type": "header", "content": "Ticker Animation & Sizing" },
    { "type": "range", "id": "speed", "min": 5, "max": 60, "step": 1, "unit": "s", "label": "Scroll Duration (Lower is faster)", "default": 20 },
    { "type": "range", "id": "font_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "Font Size", "default": 18 },
    { "type": "header", "content": "Colors & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top_desktop", "min": 4, "max": 60, "step": 2, "unit": "px", "label": "Top Padding (Desktop)", "default": 16 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 4, "max": 60, "step": 2, "unit": "px", "label": "Bottom Padding (Desktop)", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Top Padding (Mobile)", "default": 12 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Bottom Padding (Mobile)", "default": 12 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "HEAVYWEIGHT 450GSM FLEECE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker",
      "blocks": [
        { "type": "text", "settings": { "text": "LIMITED RELEASES" } },
        { "type": "text", "settings": { "text": "EXCLUSIVE DROPS" } },
        { "type": "text", "settings": { "text": "WORLDWIDE DISPATCH" } },
        { "type": "text", "settings": { "text": "450GSM ORGANIC WEAVE" } },
        { "type": "text", "settings": { "text": "ZERO MASS RESTOCKS" } }
      ]
    }
  ]
}
{% endschema %}
