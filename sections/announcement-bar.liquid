{%- if section.settings.text != blank -%}
  <div class="announcement-bar" id="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color: inherit;">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <span>{{ section.settings.text | escape }}</span>
    {%- endif -%}
    <button class="announcement-bar__close" id="announcement-close" aria-label="Dismiss">&times;</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "LIMITED RELEASES. EXCLUSIVE DROPS. ELEGANCE IS NOW LIVE."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
