[
  {
    "name": "theme_info",
    "theme_name": "WTFlex Luxury",
    "theme_author": "WTFlex Studio",
    "theme_version": "2.0.0",
    "theme_documentation_url": "https://h1bfui-vi.myshopify.com",
    "theme_support_url": "https://h1bfui-vi.myshopify.com"
  },
  {
    "name": "Branding & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Will be scaled down to 32x32px"
      }
    ]
  },
  {
    "name": "Colors & Aesthetics",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent",
        "default": "#171717"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_secondary_bg",
        "label": "Secondary Section Background",
        "default": "#f8fafc"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary Text",
        "default": "#171717"
      },
      {
        "type": "color",
        "id": "color_muted_text",
        "label": "Muted / Subtitle Text",
        "default": "#64748b"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders & Dividers",
        "default": "#e2e8f0"
      },
      {
        "type": "color",
        "id": "color_badge",
        "label": "Sale / Discount Badge Color",
        "default": "#dc2626"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success / Unlocked Reward Color",
        "default": "#16a34a"
      }
    ]
  },
  {
    "name": "Cart & Drawer Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable Side Cart Drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_shipping_bar",
        "label": "Enable Gamified Rewards Bar",
        "default": false
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold Amount (Rs.)",
        "default": 9900
      },
      {
        "type": "checkbox",
        "id": "enable_cart_discounts",
        "label": "Enable Discount Code Field in Cart Drawer",
        "default": true
      },
      {
        "type": "header",
        "content": "\"Pairs Well With\" Upsell"
      },
      {
        "type": "checkbox",
        "id": "enable_cart_upsell",
        "label": "Enable \"Pairs Well With\" Upsell in Cart Drawer",
        "default": true
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Upsell Product",
        "info": "Pick any product from your store to show in the cart drawer upsell."
      }
    ]
  },
  {
    "name": "Product Cards & Catalog",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Enable Quick Add on Product Cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_wishlist",
        "label": "Enable Wishlist Buttons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_hover_image",
        "label": "Show Secondary Image on Hover",
        "default": true
      },
      {
        "type": "header",
        "content": "Product Card Image"
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image Aspect Ratio",
        "default": "3/4",
        "info": "Controls the height of product card images across the site.",
        "options": [
          { "value": "1/1",  "label": "Square (1:1)" },
          { "value": "3/4",  "label": "Portrait 3:4 (Default)" },
          { "value": "2/3",  "label": "Portrait 2:3 (Tall)" },
          { "value": "4/5",  "label": "Portrait 4:5" },
          { "value": "auto", "label": "Natural (no crop)" }
        ]
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image Display Mode",
        "default": "cover",
        "info": "Cover = fills card (may crop). Contain = shows full image with background. Fill = stretches to fit.",
        "options": [
          { "value": "cover",   "label": "Cover (Fill & Crop)" },
          { "value": "contain", "label": "Contain (Full Image, No Crop)" },
          { "value": "fill",    "label": "Stretch (Fill Without Ratio)" }
        ]
      },
      {
        "type": "range",
        "id": "card_image_height_mobile",
        "label": "Card Image Height — Mobile (px)",
        "min": 200,
        "max": 600,
        "step": 10,
        "default": 360,
        "info": "Only used when Aspect Ratio is set to 'Natural'."
      },
      {
        "type": "range",
        "id": "card_image_height_desktop",
        "label": "Card Image Height — Desktop (px)",
        "min": 300,
        "max": 900,
        "step": 10,
        "default": 480,
        "info": "Only used when Aspect Ratio is set to 'Natural'."
      },
      {
        "type": "header",
        "content": "Product Page Gallery Image"
      },
      {
        "type": "select",
        "id": "gallery_image_ratio",
        "label": "Gallery Image Aspect Ratio",
        "default": "3/4",
        "options": [
          { "value": "1/1",  "label": "Square (1:1)" },
          { "value": "3/4",  "label": "Portrait 3:4 (Default)" },
          { "value": "2/3",  "label": "Portrait 2:3 (Tall)" },
          { "value": "4/5",  "label": "Portrait 4:5" },
          { "value": "auto", "label": "Natural (no crop)" }
        ]
      },
      {
        "type": "select",
        "id": "gallery_image_fit",
        "label": "Gallery Image Display Mode",
        "default": "cover",
        "options": [
          { "value": "cover",   "label": "Cover (Fill & Crop)" },
          { "value": "contain", "label": "Contain (Full Image, No Crop)" },
          { "value": "fill",    "label": "Stretch" }
        ]
      }
    ]
  },

  {
    "name": "Typography & Fonts",
    "settings": [
      {
        "type": "header",
        "content": "Heading Font"
      },
      {
        "type": "checkbox",
        "id": "use_default_heading_font",
        "label": "Use Default Brand Font (Moniqa-BoldHeading)",
        "default": true,
        "info": "Turn OFF to use the Font Picker below instead."
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font (active only when Default is OFF)",
        "default": "inter_n4",
        "info": "Applies to all headings (H1–H6), product titles, section titles, nav links, and buttons."
      },
      {
        "type": "header",
        "content": "Custom Uploaded Font (Optional)"
      },
      {
        "type": "paragraph",
        "content": "To use your own font: go to Theme Editor → ⋯ (three dots) → Edit code → Assets → Add a new asset → upload your .woff2 font file. Then paste the filename below."
      },
      {
        "type": "text",
        "id": "custom_heading_font_woff2",
        "label": "Custom Font File (.woff2)",
        "info": "Paste the exact filename you uploaded, e.g. my-brand-font.woff2 — the font name will be set automatically.",
        "placeholder": "e.g. my-brand-font.woff2"
      },
      {
        "type": "select",
        "id": "heading_font_weight",
        "label": "Heading Font Weight",
        "options": [
          { "value": "300", "label": "300 — Light" },
          { "value": "400", "label": "400 — Regular" },
          { "value": "500", "label": "500 — Medium" },
          { "value": "600", "label": "600 — Semi Bold" },
          { "value": "700", "label": "700 — Bold" },
          { "value": "800", "label": "800 — Extra Bold" },
          { "value": "900", "label": "900 — Black" }
        ],
        "default": "700"
      },
      {
        "type": "select",
        "id": "heading_text_transform",
        "label": "Heading Text Case",
        "options": [
          { "value": "none", "label": "Normal" },
          { "value": "uppercase", "label": "UPPERCASE" },
          { "value": "capitalize", "label": "Capitalize Each Word" }
        ],
        "default": "uppercase"
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Heading Letter Spacing",
        "default": 2
      },
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body / UI Font",
        "default": "inter_n4",
        "info": "Applies to paragraphs, descriptions, labels, and general UI text."
      },
      {
        "type": "header",
        "content": "Font Sizes — Body & UI"
      },
      {
        "type": "range",
        "id": "font_size_body",
        "label": "Body Text Size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "font_size_nav",
        "label": "Navigation Links Size",
        "min": 10,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "range",
        "id": "font_size_price",
        "label": "Price Text Size",
        "min": 12,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "font_size_announcement",
        "label": "Announcement Bar Text Size",
        "min": 10,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "header",
        "content": "Font Sizes — Headings"
      },
      {
        "type": "range",
        "id": "font_size_h1",
        "label": "H1 / Hero Title Size",
        "min": 28,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "font_size_h2",
        "label": "H2 / Section Title Size",
        "min": 22,
        "max": 72,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "font_size_h3",
        "label": "H3 / Card Title Size",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "font_size_h4",
        "label": "H4 / Sub-heading Size",
        "min": 14,
        "max": 36,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "font_size_product_title",
        "label": "Product Page Title Size",
        "min": 18,
        "max": 56,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "font_size_product_card_title",
        "label": "Product Card Title Size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      }
    ]
  }
]

