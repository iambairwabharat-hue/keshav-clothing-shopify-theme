<!-- Customer Addresses Management -->
<div class="account-page section-spacing">
  <div class="container container--narrow" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; border-bottom: 1px solid var(--color-gray-200, #e5e5e5); padding-bottom: 16px;">
      <div>
        <a href="/pages/account" style="font-size: 12px; color: #737373; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 6px;">← Return to Portal</a>
        <h1 style="font-family: var(--font-display, 'Oswald', sans-serif); font-size: 28px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin: 0; color: #171717;">SAVED ADDRESSES</h1>
      </div>
      <button type="button" onclick="document.getElementById('AddAddressForm').style.display = 'block'; this.style.display = 'none';" style="padding: 10px 20px; background: #171717; color: #fff; border: none; border-radius: 4px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">
        + Add New Address
      </button>
    </div>

    <!-- Add Address Form (Hidden by default) -->
    <div id="AddAddressForm" style="display: none; background: #fafafa; border: 1px solid #e5e5e5; border-radius: 8px; padding: 28px; margin-bottom: 40px;">
      <h3 style="font-family: var(--font-display, 'Oswald', sans-serif); font-size: 20px; font-weight: 700; text-transform: uppercase; margin-bottom: 20px;">Add New Address</h3>
      {%- form 'customer_address', customer.new_address -%}
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 14px;">
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">First Name</label>
            <input type="text" name="address[first_name]" value="{{ form.first_name }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Last Name</label>
            <input type="text" name="address[last_name]" value="{{ form.last_name }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
          </div>
        </div>
        <div style="margin-bottom: 14px;">
          <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Address Line 1</label>
          <input type="text" name="address[address1]" value="{{ form.address1 }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 14px;">
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">City</label>
            <input type="text" name="address[city]" value="{{ form.city }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Country</label>
            <input type="text" name="address[country]" value="{{ form.country }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Postal / ZIP Code</label>
            <input type="text" name="address[zip]" value="{{ form.zip }}" required style="width: 100%; padding: 10px; border: 1px solid #d4d4d4; border-radius: 4px;">
          </div>
        </div>
        <div style="margin-bottom: 20px;">
          <label style="font-size: 13px; display: flex; align-items: center; gap: 8px; cursor: pointer;">
            {{ form.set_as_default_checkbox }}
            Set as default delivery address
          </label>
        </div>
        <div style="display: flex; gap: 12px;">
          <button type="submit" style="padding: 12px 24px; background: #171717; color: #fff; border: none; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">Save Address</button>
          <button type="button" onclick="document.getElementById('AddAddressForm').style.display = 'none';" style="padding: 12px 20px; background: transparent; border: 1px solid #d4d4d4; border-radius: 4px; cursor: pointer;">Cancel</button>
        </div>
      {%- endform -%}
    </div>

    <!-- Existing Addresses Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      {%- for address in customer.addresses -%}
        <div style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 24px; background: #fff; position: relative;">
          {%- if address == customer.default_address -%}
            <span style="position: absolute; top: 16px; right: 16px; font-size: 10px; font-weight: 700; background: #171717; color: #fff; padding: 3px 8px; border-radius: 2px; text-transform: uppercase;">Default</span>
          {%- endif -%}
          <div style="font-weight: 700; font-size: 15px; margin-bottom: 8px; color: #171717;">{{ address.first_name }} {{ address.last_name }}</div>
          <div style="font-size: 13.5px; line-height: 1.6; color: #525252; margin-bottom: 16px;">
            {{ address | format_address }}
          </div>
          <form method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('Are you sure you want to delete this address?');">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" style="background: none; border: none; color: #dc2626; font-size: 12px; font-weight: 600; text-decoration: underline; cursor: pointer; padding: 0;">Delete Address</button>
          </form>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
