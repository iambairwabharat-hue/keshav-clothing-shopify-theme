<!-- Customer Login & Password Recovery -->
<div class="customer-auth-section section-spacing">
  <div class="container container--narrow" style="max-width: 480px; margin: 60px auto; padding: 0 20px;">
    
    <!-- Login Form -->
    <div id="CustomerLoginForm" class="customer-auth-box" style="background: #ffffff; border: 1px solid var(--color-gray-200, #e5e5e5); border-radius: 8px; padding: 40px 32px; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.06)); text-align: center;">
      <h1 style="font-family: var(--font-display, 'Oswald', sans-serif); font-size: 28px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; color: #171717;">CLIENT ACCESS</h1>
      <p style="font-size: 13px; color: var(--color-gray-500, #737373); margin-bottom: 28px;">Sign in to access your order history, saved favorites, and private drop coordinates.</p>

      {%- form 'customer_login', class: 'customer-form' -%}
        {%- if form.errors -%}
          <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px; border-radius: 4px; font-size: 13px; margin-bottom: 20px; text-align: left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: 16px; text-align: left;">
          <label for="CustomerEmail" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">Email Address</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;" placeholder="name@domain.com">
        </div>

        {%- if form.password_needed -%}
          <div style="margin-bottom: 20px; text-align: left;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label for="CustomerPassword" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717;">Password</label>
              <a href="#recover" onclick="showRecoverForm(); return false;" style="font-size: 12px; color: #737373; text-decoration: underline;">Forgot password?</a>
            </div>
            <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;" placeholder="••••••••••••">
          </div>
        {%- endif -%}

        <button type="submit" class="btn" style="width: 100%; padding: 14px; background: #171717; color: #ffffff; font-family: var(--font-display, 'Oswald', sans-serif); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; border: none; border-radius: 4px; cursor: pointer; transition: opacity 0.2s;">
          Sign In
        </button>

        <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e5e5; font-size: 13px; color: #737373;">
          New client? <a href="{{ routes.account_register_url }}" style="color: #171717; font-weight: 600; text-decoration: underline;">Create an account</a>
        </div>
      {%- endform -%}
    </div>

    <!-- Recover Password Form -->
    <div id="RecoverPasswordForm" class="customer-auth-box" style="display: none; background: #ffffff; border: 1px solid var(--color-gray-200, #e5e5e5); border-radius: 8px; padding: 40px 32px; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.06)); text-align: center;">
      <h2 style="font-family: var(--font-display, 'Oswald', sans-serif); font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; color: #171717;">RESET PASSWORD</h2>
      <p style="font-size: 13px; color: var(--color-gray-500, #737373); margin-bottom: 24px;">We will send you an email to reset your account password.</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px; border-radius: 4px; font-size: 13px; margin-bottom: 20px; text-align: left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: 20px; text-align: left;">
          <label for="RecoverEmail" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">Email Address</label>
          <input type="email" name="email" id="RecoverEmail" autocorrect="off" autocapitalize="off" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;" placeholder="name@domain.com">
        </div>

        <button type="submit" class="btn" style="width: 100%; padding: 14px; background: #171717; color: #ffffff; font-family: var(--font-display, 'Oswald', sans-serif); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; border: none; border-radius: 4px; cursor: pointer;">
          Submit Reset Request
        </button>

        <div style="margin-top: 20px;">
          <a href="#login" onclick="hideRecoverForm(); return false;" style="font-size: 13px; color: #737373; text-decoration: underline;">Cancel and return to Sign In</a>
        </div>
      {%- endform -%}
    </div>

  </div>
</div>

<script>
  function showRecoverForm() {
    document.getElementById('RecoverPasswordForm').style.display = 'block';
    document.getElementById('CustomerLoginForm').style.display = 'none';
  }
  function hideRecoverForm() {
    document.getElementById('RecoverPasswordForm').style.display = 'none';
    document.getElementById('CustomerLoginForm').style.display = 'block';
  }
  if (window.location.hash === '#recover') {
    showRecoverForm();
  }
</script>
