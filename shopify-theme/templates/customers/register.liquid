<!-- Customer Registration -->
<div class="customer-auth-section section-spacing">
  <div class="container container--narrow" style="max-width: 480px; margin: 60px auto; padding: 0 20px;">
    <div class="customer-auth-box" style="background: #ffffff; border: 1px solid var(--color-gray-200, #e5e5e5); border-radius: 8px; padding: 40px 32px; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.06)); text-align: center;">
      <h1 style="font-family: var(--font-display, 'Oswald', sans-serif); font-size: 28px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; color: #171717;">JOIN THE CIRCLE</h1>
      <p style="font-size: 13px; color: var(--color-gray-500, #737373); margin-bottom: 28px;">Create a client profile for exclusive access, fast checkout, and saved favorites curation.</p>

      {%- form 'create_customer', class: 'customer-form' -%}
        {%- if form.errors -%}
          <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px; border-radius: 4px; font-size: 13px; margin-bottom: 20px; text-align: left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: 16px; text-align: left;">
          <label for="RegisterFirstName" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">First Name</label>
          <input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;">
        </div>

        <div style="margin-bottom: 16px; text-align: left;">
          <label for="RegisterLastName" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">Last Name</label>
          <input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;">
        </div>

        <div style="margin-bottom: 16px; text-align: left;">
          <label for="RegisterEmail" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">Email Address</label>
          <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;">
        </div>

        <div style="margin-bottom: 16px; text-align: left;">
          <label for="RegisterPhone" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">WhatsApp / Mobile Number</label>
          <input type="tel" name="customer[phone]" id="RegisterPhone" autocorrect="off" autocapitalize="off" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;" placeholder="+91 98765 43210">
          <span style="font-size: 11px; color: #737373; margin-top: 4px; display: block;">Required for order tracking & VIP drop alerts via WhatsApp.</span>
        </div>

        <div style="margin-bottom: 24px; text-align: left;">
          <label for="RegisterPassword" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #171717; margin-bottom: 6px;">Password</label>
          <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required style="width: 100%; padding: 12px 14px; border: 1px solid #d4d4d4; border-radius: 4px; font-size: 14px; font-family: inherit; outline: none;">
        </div>

        <button type="submit" class="btn" style="width: 100%; padding: 14px; background: #171717; color: #ffffff; font-family: var(--font-display, 'Oswald', sans-serif); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; border: none; border-radius: 4px; cursor: pointer;">
          Create Client Profile
        </button>

        <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e5e5; font-size: 13px; color: #737373;">
          Already have an account? <a href="{{ routes.account_login_url }}" style="color: #171717; font-weight: 600; text-decoration: underline;">Sign In</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
