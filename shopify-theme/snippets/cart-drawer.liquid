<!-- Side Cart Drawer Backdrop -->
<div class="side-cart-backdrop" id="side-cart-backdrop"></div>

<!-- Side Cart Drawer -->
<div class="side-cart-drawer" id="side-cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <!-- 1. Header -->
  <div class="side-cart-header">
    <div class="side-cart-title">
      Your Bag <span class="side-cart-count-badge" id="side-cart-badge-count">0</span>
    </div>
    <button type="button" class="side-cart-close" id="side-cart-close" aria-label="Close cart drawer">
      <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- 2. 3-Tier Gamified Rewards Meter -->
  <div class="side-cart-rewards">
    <div class="side-cart-rewards__header">
      <span class="side-cart-rewards__message" id="side-cart-shipping-text">
        Add <strong>Rs. 9900</strong> for <strong>FREE Global Shipping</strong>
      </span>
    </div>
    <div class="side-cart-rewards__progress-wrap">
      <div class="side-cart-rewards__bar" id="side-cart-shipping-bar" style="width: 0%;"></div>
    </div>
    <!-- 3 Milestone Checkpoints -->
    <div class="side-cart-rewards__tiers">
      <div class="reward-tier" data-tier="1" data-threshold="99">
        <span class="reward-tier__dot"></span>
        <span class="reward-tier__label">Free Ship (Rs. 9900)</span>
      </div>
      <div class="reward-tier" data-tier="2" data-threshold="150">
        <span class="reward-tier__dot"></span>
        <span class="reward-tier__label">Free Tote (Rs. 15000)</span>
      </div>
      <div class="reward-tier" data-tier="3" data-threshold="250">
        <span class="reward-tier__dot"></span>
        <span class="reward-tier__label">VIP Key (Rs. 25000)</span>
      </div>
    </div>
  </div>

  <!-- 3. Scrollable Body -->
  <div class="side-cart-body" id="side-cart-body">
    <!-- Dynamic Items List -->
    <div class="side-cart-items-list" id="side-cart-items-list"></div>

    <!-- Empty State -->
    <div class="side-cart-empty" id="side-cart-empty" style="display: none;">
      <div class="side-cart-empty__icon">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2" fill="none"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
      <h3 class="side-cart-empty__title">Your bag is empty</h3>
      <p class="side-cart-empty__text">Discover luxury streetwear and handcrafted statement pieces.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-side-cart-shop" id="btn-side-cart-shop">Shop Latest Drops</a>
    </div>

    <!-- Upsell Section — dynamically driven by Theme Editor product picker -->
    {%- if settings.enable_cart_upsell != false -%}
      {%- assign upsell_product = settings.cart_upsell_product -%}
      {%- if upsell_product != blank -%}
        {%- assign upsell_variant = upsell_product.first_available_variant | default: upsell_product.variants.first -%}
        {%- assign upsell_image = upsell_product.featured_image | img_url: '300x400', crop: 'center' -%}
        {%- assign upsell_price = upsell_variant.price | money -%}
        {%- assign upsell_compare = upsell_variant.compare_at_price -%}
        <div class="side-cart-upsell" id="side-cart-upsell">
          <div class="side-cart-upsell-title">Pairs well with</div>
          <div class="side-cart-upsell-card">
            <a href="{{ upsell_product.url }}" class="side-cart-upsell-img-link">
              <img src="{{ upsell_image }}" alt="{{ upsell_product.title | escape }}" class="side-cart-upsell-thumb" loading="lazy">
            </a>
            <div class="side-cart-upsell-info">
              <a href="{{ upsell_product.url }}" class="side-cart-upsell-name">{{ upsell_product.title }}</a>
              <div class="side-cart-upsell-price">
                {%- if upsell_compare and upsell_compare > upsell_variant.price -%}
                  <span class="side-cart-upsell-price--sale">{{ upsell_price }}</span>
                  <span class="side-cart-upsell-price--compare">{{ upsell_compare | money }}</span>
                {%- else -%}
                  {{ upsell_price }}
                {%- endif -%}
              </div>
            </div>
            {%- if upsell_variant.available -%}
              <button
                type="button"
                class="btn-upsell-add"
                data-upsell-variant-id="{{ upsell_variant.id }}"
                data-upsell-title="{{ upsell_product.title | escape }}"
                data-upsell-price="{{ upsell_variant.price | divided_by: 100.0 }}"
                data-upsell-image="{{ upsell_image }}"
                data-upsell-url="{{ upsell_product.url }}"
              >+ Add</button>
            {%- else -%}
              <span class="btn-upsell-soldout">Sold Out</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>

  <!-- 4. Footer Checkout -->
  <div class="side-cart-footer" id="side-cart-footer">
    <!-- Discount / Coupon Code -->
    <div class="side-cart-discount-section" id="side-cart-discount-section">
      <div class="side-cart-discount-toggle" id="side-cart-discount-toggle">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.5" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <span>Have a discount code?</span>
        <svg class="side-cart-discount-chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="side-cart-discount-form" id="side-cart-discount-form" style="display: none;">
        <div class="side-cart-discount-input-wrap">
          <input type="text" class="side-cart-discount-input" id="side-cart-discount-input" placeholder="Enter discount code" autocomplete="off">
          <button type="button" class="side-cart-discount-apply" id="side-cart-discount-apply">Apply</button>
        </div>
        <div class="side-cart-discount-msg" id="side-cart-discount-msg" style="display: none;"></div>
      </div>
    </div>

    <!-- Automatic Discounts -->
    <div class="side-cart-auto-discounts" id="side-cart-auto-discounts" style="display: none;"></div>

    <div class="side-cart-subtotal-row">
      <span class="side-cart-subtotal-label">Subtotal</span>
      <span class="side-cart-subtotal-amount" id="side-cart-subtotal">Rs. 0</span>
    </div>
    <div class="side-cart-taxes-note">Shipping, taxes, and promotional discounts calculated at checkout.</div>
    <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form" style="width: 100%; margin: 0;">
      <button type="submit" name="checkout" class="btn-side-cart-checkout" id="btn-side-cart-checkout" style="width: 100%;">
        <span>Proceed to Checkout</span>
        <span>→</span>
      </button>
    </form>
    <div class="side-cart-trust">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      <span>Guaranteed 256-Bit SSL Encrypted Checkout</span>
    </div>
  </div>
</div>
