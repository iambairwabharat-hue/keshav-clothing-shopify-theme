{% doc %}
  @prompt
    an 4 image in single row without any gap padding and margin, each one with link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-row__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .ai-image-row__item-{{ ai_gen_id }} {
    position: relative;
    margin: 0;
    padding: 0;
    display: block;
    overflow: hidden;
  }

  .ai-image-row__link-{{ ai_gen_id }} {
    display: block;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .ai-image-row__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    padding: 0;
    object-fit: cover;
  }

  .ai-image-row__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .ai-image-row__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  @media screen and (max-width: 749px) {
    .ai-image-row__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<four-image-row-{{ ai_gen_id }} class="ai-image-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-row__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
      %}
      <div class="ai-image-row__item-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-image-row__link-{{ ai_gen_id }}">
            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-image-row__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-image-row__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          {% if image != blank %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-image-row__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-image-row__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</four-image-row-{{ ai_gen_id }}>

<script>
  (function() {
    class FourImageRow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('four-image-row-{{ ai_gen_id }}', FourImageRow{{ ai_gen_id }});
  })();
</script>

