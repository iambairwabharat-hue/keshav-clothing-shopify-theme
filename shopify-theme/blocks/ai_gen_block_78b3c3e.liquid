{% doc %}
  @prompt
     4 BANNER IN SINGLE ROW WITH URL, WITHOUT ANY GAP AND PADDING AND NO TEXT OR BUTTON JUST URL LINKD
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-banner-row__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    width: 100%;
  }

  .ai-banner-row__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    display: block;
    text-decoration: none;
  }

  .ai-banner-row__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-banner-row__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-banner-row__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-row__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-row__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-banner-row__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-banner-row__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-banner-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-row__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'banner_' | append: i | append: '_image'
        assign url_key = 'banner_' | append: i | append: '_url'
        
        assign banner_image = block.settings[image_key]
        assign banner_url = block.settings[url_key]
      %}

      {% if banner_url != blank %}
        <a href="{{ banner_url }}" class="ai-banner-row__item-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-banner-row__item-{{ ai_gen_id }}">
      {% endif %}

        <div class="ai-banner-row__image-wrapper-{{ ai_gen_id }}">
          {% if banner_image %}
            <img
              src="{{ banner_image | image_url: width: 800 }}"
              alt="{{ banner_image.alt | escape }}"
              loading="lazy"
              width="{{ banner_image.width }}"
              height="{{ banner_image.height }}"
              class="ai-banner-row__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-banner-row__placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
              <div class="ai-banner-row__empty-state-{{ ai_gen_id }}">
                Add image for banner {{ i }}
              </div>
            </div>
          {% endif %}
        </div>

      {% if banner_url != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Four banner row",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "header",
      "content": "Banner 1"
    },
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "banner_1_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Banner 2"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "banner_2_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Banner 3"
    },
    {
      "type": "image_picker",
      "id": "banner_3_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "banner_3_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Banner 4"
    },
    {
      "type": "image_picker",
      "id": "banner_4_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "banner_4_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Four banner row"
    }
  ]
}
{% endschema %}
