{%- comment -%}
  KCCLOTHING - TikTok / Reels 9:16 Video Showcase (Pure Touch Carousel without Arrow Buttons + Title Alignment)
{%- endcomment -%}

{%- style -%}
  #video-reels-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top_desktop }}px;
    --section-pb: {{ section.settings.padding_bottom_desktop }}px;
    --section-pt-mob: {{ section.settings.padding_top_mobile }}px;
    --section-pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --bg-color: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  @media (max-width: 768px) {
    #video-reels-{{ section.id }} {
      padding-top: var(--section-pt-mob);
      padding-bottom: var(--section-pb-mob);
    }
  }

  #video-reels-{{ section.id }} .video-reel-card {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
  }
{%- endstyle -%}

<section class="video-reels-section{% if section.settings.full_width %} video-reels--full-width{% else %} container container--wide{% endif %}" id="video-reels-{{ section.id }}" data-section-id="{{ section.id }}">
  
  <div class="section-header text-{{ section.settings.heading_alignment | default: 'center' }}" style="margin-bottom: 28px; text-align: {{ section.settings.heading_alignment | default: 'center' }};">
    <span class="section-subtitle" style="color: rgba(255,255,255,0.7); display: block; margin-bottom: 6px;">{{ section.settings.subtitle | default: 'MOTION ARCHIVE' }}</span>
    <h2 class="section-title" style="color: #ffffff; margin: 0;">{{ section.settings.heading | default: 'KCCLOTHING IN MOTION' }}</h2>
  </div>

  <div class="video-reels-track-wrap">
    <div class="video-reels-track" id="video-reels-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}

        {%- assign display_title = block.settings.product_title -%}
        {%- if prod != blank and prod.title != blank -%}
          {%- assign display_title = prod.title -%}
        {%- endif -%}

        {%- assign display_price = block.settings.product_price -%}
        {%- if prod != blank and prod.price != blank -%}
          {%- assign display_price = prod.price | money -%}
        {%- endif -%}

        {%- assign add_price_raw = 59.99 -%}
        {%- if prod != blank and prod.price != blank -%}
          {%- assign add_price_raw = prod.price | divided_by: 100.0 -%}
        {%- elsif block.settings.product_price != blank -%}
          {%- assign add_price_raw = block.settings.product_price | remove: '$' | remove: '₹' | remove: 'Rs.' | strip -%}
        {%- endif -%}

        {%- assign variant_id = prod.selected_or_first_available_variant.id | default: block.settings.variant_id | default: forloop.index -%}

        {%- assign thumb_src = 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=200' -%}
        {%- if block.settings.product_image != blank -%}
          {%- assign thumb_src = block.settings.product_image | image_url: width: 200 -%}
        {%- elsif prod != blank and prod.featured_image != blank -%}
          {%- assign thumb_src = prod.featured_image | image_url: width: 200 -%}
        {%- endif -%}

        {%- assign reel_poster = 'https://images.unsplash.com/photo-1578768079470-fa9cf84ca1e3?w=600&h=1067&fit=crop' -%}
        {%- if block.settings.poster_image != blank -%}
          {%- assign reel_poster = block.settings.poster_image | image_url: width: 600 -%}
        {%- elsif prod != blank and prod.featured_image != blank -%}
          {%- assign reel_poster = prod.featured_image | image_url: width: 600 -%}
        {%- endif -%}

        <div class="video-reel-card" {{ block.shopify_attributes }}>
          
          <div class="video-reel-media">
            {%- if block.settings.video_url != blank -%}
              <video
                class="video-reel-player"
                src="{{ block.settings.video_url }}"
                poster="{{ reel_poster }}"
                loop
                muted
                playsinline
                preload="metadata"
              ></video>
            {%- else -%}
              <img
                src="{{ reel_poster }}"
                alt="{{ display_title | escape }}"
                class="video-reel-poster"
                loading="lazy"
              >
            {%- endif -%}

            <!-- Audio Toggle -->
            <button type="button" class="video-reel-sound-btn" aria-label="Toggle Sound">
              <svg class="icon-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
              <svg class="icon-unmuted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" style="display: none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            </button>

            <!-- Play Indicator -->
            <div class="video-reel-play-indicator">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="#ffffff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            </div>

            <!-- Floating Glass Product Tag -->
            <div class="video-reel-product-card">
              <a href="{{ prod.url | default: routes.all_products_collection_url }}" class="video-reel-prod-thumb" style="display:block;">
                <img src="{{ thumb_src }}" alt="{{ display_title | escape }}" loading="lazy">
              </a>
              <div class="video-reel-prod-info">
                <a href="{{ prod.url | default: routes.all_products_collection_url }}" style="text-decoration:none; color:inherit;">
                  <div class="video-reel-prod-title">{{ display_title }}</div>
                </a>
                <div class="video-reel-prod-price">{{ display_price }}</div>
              </div>
              <button
                type="button"
                class="video-reel-prod-add"
                data-variant-id="{{ variant_id }}"
                data-product-id="{{ prod.id | default: forloop.index }}"
                data-product-title="{{ display_title | escape }}"
                data-price="{{ add_price_raw }}"
                data-image="{{ thumb_src }}"
                aria-label="Add {{ display_title | escape }} to Bag"
              >
                + ADD
              </button>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Video Reels Showcase",
  "settings": [
    { "type": "header", "content": "Heading & Alignment" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "MOTION ARCHIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "KCCLOTHING IN MOTION" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "card_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card Border Radius", "default": 12 },
    { "type": "checkbox", "id": "full_width", "label": "Full Width Section", "default": false },
    { "type": "header", "content": "Colors & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top Padding (Desktop)", "default": 72 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom Padding (Desktop)", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top Padding (Mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom Padding (Mobile)", "default": 40 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "9:16 Video Reel",
      "settings": [
        { "type": "product", "id": "product", "label": "Select Shopify Product (Auto pulls title, price & image)" },
        { "type": "text", "id": "video_url", "label": "Direct MP4/WebM Video URL" },
        { "type": "image_picker", "id": "poster_image", "label": "Video Poster / Cover Image" },
        { "type": "header", "content": "Fallback Overrides" },
        { "type": "text", "id": "product_title", "label": "Product Title", "default": "450GSM Archival Boxy Hoodie" },
        { "type": "text", "id": "product_price", "label": "Product Price", "default": "$69.99" },
        { "type": "image_picker", "id": "product_image", "label": "Garment Thumbnail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Reels Showcase",
      "blocks": [
        { "type": "reel", "settings": { "product_title": "450GSM Archival Boxy Hoodie", "product_price": "$69.99" } },
        { "type": "reel", "settings": { "product_title": "Dastaan Indigo Boxy Tee", "product_price": "$39.99" } },
        { "type": "reel", "settings": { "product_title": "Tactical Double-Pleat Cargo", "product_price": "$59.99" } },
        { "type": "reel", "settings": { "product_title": "Surreal Heritage Football Jersey", "product_price": "$48.00" } }
      ]
    }
  ]
}
{% endschema %}
