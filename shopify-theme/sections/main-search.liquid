{%- paginate search.results by section.settings.products_per_page -%}

<!-- Search Hero Banner -->
<section class="collection-hero search-hero">
  <div class="collection-hero__content scroll-reveal">
    <div class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="separator">/</span>
      <span>Search Results</span>
    </div>

    {%- if search.performed -%}
      <h1 class="collection-hero__title">
        Search: "{{ search.terms | escape }}"
      </h1>
      <div class="collection-hero__desc">
        {%- if search.results_count == 1 -%}
          1 garment found matching your query
        {%- else -%}
          {{ search.results_count }} garments found matching your query
        {%- endif -%}
      </div>
    {%- else -%}
      <h1 class="collection-hero__title">Search Catalog</h1>
      <div class="collection-hero__desc">Explore luxury streetwear silhouettes, heavyweights, and statement drops.</div>
    {%- endif -%}

    <!-- In-Page Search Refine Bar -->
    <div class="search-page-bar-wrap" style="max-width: 600px; margin: 24px auto 0;">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form" style="background: #ffffff; border-radius: 4px; padding: 6px 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
        <span class="search-modal__icon">
          {% render 'icon', icon: 'search' %}
        </span>
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          class="search-modal__input"
          placeholder="Search collections, silhouettes, drops..."
          style="font-size: 16px; padding: 8px 0;"
          autocomplete="off"
        >
        <button type="submit" class="btn-search-submit" style="background: #000000; color: #ffffff; border: none; padding: 8px 18px; border-radius: 4px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; cursor: pointer;">
          Search
        </button>
      </form>
    </div>
  </div>
</section>

{%- if search.performed and search.results.size > 0 -%}
  <!-- Search Sticky Toolbar -->
  <div class="collection-toolbar-wrap">
    <div class="collection-toolbar">
      <div class="toolbar-left">
        {%- if section.settings.enable_filtering -%}
          <button class="btn-filter-trigger" id="filter-trigger" aria-expanded="false">
            {% render 'icon', icon: 'filter' %}
            Filters
          </button>
        {%- endif -%}
        <span class="product-counter">
          {{ search.results_count }} Pieces
        </span>
      </div>

      <div class="toolbar-right">
        {%- if section.settings.enable_sorting -%}
          <div class="sort-select-wrapper">
            {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
            <select name="sort_by" class="sort-select" id="sort-by" aria-label="Sort products" onchange="window.handleSortChange(this.value)">
              {%- for option in search.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', icon: 'chevron-down' %}
          </div>
        {%- endif -%}

        <div class="grid-view-switcher">
          <button type="button" class="btn-grid-view" data-cols="2" aria-label="2 Columns">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="3" y="3" width="7" height="18" rx="1"></rect><rect x="14" y="3" width="7" height="18" rx="1"></rect></svg>
          </button>
          <button type="button" class="btn-grid-view" data-cols="3" aria-label="3 Columns">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="2" y="3" width="5" height="18" rx="1"></rect><rect x="9.5" y="3" width="5" height="18" rx="1"></rect><rect x="17" y="3" width="5" height="18" rx="1"></rect></svg>
          </button>
          <button type="button" class="btn-grid-view btn-grid-view--active" data-cols="4" aria-label="4 Columns">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="2" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="7.5" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="13" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="18.5" y="3" width="3.5" height="18" rx="0.5"></rect></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Active Facets Bar -->
    {%- if search.filters != empty -%}
      <div class="active-facets-bar">
        {%- for filter in search.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="active-facet-pill">
              <span>{{ filter.label }}: {{ value.label }}</span>
              {% render 'icon', icon: 'close' %}
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Mobile Filter Backdrop -->
  <div class="filter-backdrop" id="filter-backdrop"></div>

  <!-- Main Search Results Layout -->
  <div class="collection-container">
    {%- if section.settings.enable_filtering -%}
      <aside class="filter-sidebar" id="filter-sidebar">
        {% render 'facets', results: search %}
      </aside>
    {%- endif -%}

    <main class="collection-main">
      <div class="collection-grid grid--4-col" id="collection-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </main>
  </div>

{%- elsif search.performed -%}
  <!-- Zero Results Empty State -->
  <div class="search-empty-state" style="padding: 80px 20px; text-align: center; max-width: 600px; margin: 0 auto;">
    <h3 style="font-size: 24px; font-weight: 700; margin-bottom: 12px; text-transform: uppercase;">No garments found</h3>
    <p style="font-size: 15px; color: #737373; margin-bottom: 32px;">No results found for "{{ search.terms | escape }}". Check your spelling or explore popular categories below.</p>
    
    <div class="search-trending__pills" style="justify-content: center; margin-bottom: 40px; display: flex; flex-wrap: wrap; gap: 10px;">
      <a href="{{ routes.collections_url }}/hoodies" class="search-pill" style="text-decoration: none;">Heavyweight Hoodies</a>
      <a href="{{ routes.collections_url }}/jackets" class="search-pill" style="text-decoration: none;">Statement Jackets</a>
      <a href="{{ routes.collections_url }}/tees" class="search-pill" style="text-decoration: none;">Graphic Tees</a>
      <a href="{{ routes.all_products_collection_url }}" class="search-pill" style="text-decoration: none;">All Releases</a>
    </div>

    <a href="{{ routes.all_products_collection_url }}" class="btn-search-view-all" style="display: inline-block;">Browse Full Collection &rarr;</a>
  </div>
{%- endif -%}

{%- endpaginate -%}

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
