{%- style -%}
  #error-404-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top_desktop }}px;
    --section-pb: {{ section.settings.padding_bottom_desktop }}px;
    --section-pt-mob: {{ section.settings.padding_top_mobile }}px;
    --section-pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --bg-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --text-color: {{ section.settings.text_color | default: '#171717' }};
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  @media (max-width: 768px) {
    #error-404-{{ section.id }} {
      padding-top: var(--section-pt-mob);
      padding-bottom: var(--section-pb-mob);
    }
  }

  .error-404__inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    padding: 0 var(--container-padding);
  }

  .error-404__number {
    font-family: var(--font-heading, 'Oswald', sans-serif);
    font-size: clamp(80px, 16vw, 160px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 4px;
    color: var(--text-color);
    margin-bottom: 16px;
  }

  .error-404__title {
    font-family: var(--font-heading, 'Oswald', sans-serif);
    font-size: clamp(20px, 4vw, 32px);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .error-404__desc {
    font-size: 15px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 36px;
  }

  .error-404__search {
    max-width: 480px;
    margin: 0 auto 36px auto;
    position: relative;
  }

  .error-404__search-input {
    width: 100%;
    padding: 14px 48px 14px 20px;
    border: 1.5px solid #d4d4d4;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .error-404__search-input:focus {
    border-color: #000;
  }

  .error-404__search-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
  }

  .error-404__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 40px;
  }

  .error-404__pill {
    padding: 8px 16px;
    background: #f4f4f4;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #171717;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .error-404__pill:hover {
    background: #000;
    color: #fff;
  }

  .error-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
{%- endstyle -%}

<section class="error-404" id="error-404-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="error-404__inner scroll-reveal">
    <div class="error-404__number">404</div>
    <h1 class="error-404__title">{{ section.settings.heading | default: 'THE PIECE HAS VANISHED' }}</h1>
    <p class="error-404__desc">{{ section.settings.text | default: 'The silhouette or archive drop you are looking for has moved, sold out, or does not exist.' }}</p>

    {%- if section.settings.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="error-404__search">
        <input type="search" name="q" class="error-404__search-input" placeholder="Search silhouettes, hoodies, tees..." aria-label="Search">
        <button type="submit" class="error-404__search-btn" aria-label="Submit search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    {%- endif -%}

    {%- if section.settings.show_trending_pills -%}
      <div class="error-404__pills">
        <span style="font-size: 11px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 1px; width: 100%; margin-bottom: 4px;">Explore Popular Vaults:</span>
        <a href="{{ routes.all_products_collection_url }}" class="error-404__pill">All Garments</a>
        <a href="/collections/hoodies" class="error-404__pill">Heavyweight Hoodies</a>
        <a href="/collections/tees" class="error-404__pill">Boxy Tees</a>
        <a href="/collections/outerwear" class="error-404__pill">Outerwear</a>
      </div>
    {%- endif -%}

    <div class="error-404__actions">
      <a href="{{ section.settings.primary_btn_link | default: routes.all_products_collection_url }}" class="hero-btn hero-btn--solid_black">
        <span>{{ section.settings.primary_btn_label | default: 'EXPLORE LATEST DROPS' }}</span>
        <span>?</span>
      </a>
      <a href="{{ section.settings.secondary_btn_link | default: routes.root_url }}" class="hero-btn hero-btn--outline_black">
        <span>{{ section.settings.secondary_btn_label | default: 'RETURN TO HOME' }}</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page Content",
  "settings": [
    { "type": "header", "content": "Typography & Messaging" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE PIECE HAS VANISHED" },
    { "type": "textarea", "id": "text", "label": "Description Text", "default": "The silhouette or archive drop you are looking for has moved, sold out, or does not exist." },
    { "type": "header", "content": "Search & Quick Links" },
    { "type": "checkbox", "id": "show_search", "label": "Show Direct Search Input", "default": true },
    { "type": "checkbox", "id": "show_trending_pills", "label": "Show Popular Collection Pills", "default": true },
    { "type": "header", "content": "Action Buttons" },
    { "type": "text", "id": "primary_btn_label", "label": "Primary Button Label", "default": "EXPLORE LATEST DROPS" },
    { "type": "url", "id": "primary_btn_link", "label": "Primary Button Link" },
    { "type": "text", "id": "secondary_btn_label", "label": "Secondary Button Label", "default": "RETURN TO HOME" },
    { "type": "url", "id": "secondary_btn_link", "label": "Secondary Button Link" },
    { "type": "header", "content": "Colors & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#171717" },
    { "type": "range", "id": "padding_top_desktop", "min": 20, "max": 180, "step": 4, "unit": "px", "label": "Top Padding (Desktop)", "default": 100 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 20, "max": 180, "step": 4, "unit": "px", "label": "Bottom Padding (Desktop)", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Top Padding (Mobile)", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Bottom Padding (Mobile)", "default": 60 }
  ]
}
{% endschema %}
