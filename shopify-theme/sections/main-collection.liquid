{%- paginate collection.products by section.settings.products_per_page -%}

<!-- Collection Hero Banner -->
<section class="collection-hero">
  {%- if collection.image != blank -%}
    <div class="collection-hero__bg">
      <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.title | escape }}">
    </div>
  {%- endif -%}
  <div class="collection-hero__content scroll-reveal">
    <div class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="separator">/</span>
      <a href="{{ routes.collections_url }}">Collections</a>
      <span class="separator">/</span>
      <span>{{ collection.title }}</span>
    </div>
    <h1 class="collection-hero__title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-hero__desc">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

<!-- Collection Sticky Toolbar -->
<div class="collection-toolbar-wrap">
  <div class="collection-toolbar">
    <div class="toolbar-left">
      {%- if section.settings.enable_filtering -%}
        <button class="btn-filter-trigger" id="filter-trigger" aria-expanded="false">
          {% render 'icon', icon: 'filter' %}
          Filters
        </button>
      {%- endif -%}
      <span class="product-counter">
        {{ 'sections.collection_template.product_count' | t: count: collection.products_count }}
      </span>
    </div>

    <div class="toolbar-right">
      {%- if section.settings.enable_sorting -%}
        <div class="sort-select-wrapper">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select name="sort_by" class="sort-select" id="sort-by" aria-label="Sort products" onchange="window.handleSortChange(this.value)">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron-down' %}
        </div>
      {%- endif -%}

      <div class="grid-view-switcher">
        <button type="button" class="btn-grid-view" data-cols="2" aria-label="2 Columns">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="3" y="3" width="7" height="18" rx="1"></rect><rect x="14" y="3" width="7" height="18" rx="1"></rect></svg>
        </button>
        <button type="button" class="btn-grid-view btn-grid-view--active" data-cols="3" aria-label="3 Columns">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="2" y="3" width="5" height="18" rx="1"></rect><rect x="9.5" y="3" width="5" height="18" rx="1"></rect><rect x="17" y="3" width="5" height="18" rx="1"></rect></svg>
        </button>
        <button type="button" class="btn-grid-view" data-cols="4" aria-label="4 Columns">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none"><rect x="2" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="7.5" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="13" y="3" width="3.5" height="18" rx="0.5"></rect><rect x="18.5" y="3" width="3.5" height="18" rx="0.5"></rect></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Active Facets Bar -->
  {%- if collection.filters != empty -%}
    <div class="active-facets-bar">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="active-facet-pill">
            <span>{{ filter.label }}: {{ value.label }}</span>
            {% render 'icon', icon: 'close' %}
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<!-- Mobile Filter Backdrop -->
<div class="filter-backdrop" id="filter-backdrop"></div>

<!-- Main Collection Layout -->
<div class="collection-container">
  {%- if section.settings.enable_filtering -%}
    <aside class="filter-sidebar" id="filter-sidebar">
      {% render 'facets', results: collection %}
    </aside>
  {%- endif -%}

  <main class="collection-main">
    <div class="collection-grid grid--3-col" id="collection-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'sections.collection_template.empty' | t }}</p>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </main>
</div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
