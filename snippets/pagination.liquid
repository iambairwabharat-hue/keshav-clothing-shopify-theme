{%- comment -%}
  Renders pagination
  Accepts:
  - paginate: {Object} Paginate Liquid object
{%- endcomment -%}

{%- if paginate.parts.size > 0 -%}
  <div class="collection-pagination">
    <p class="progress-counter-text">
      Showing {{ paginate.current_offset | plus: paginate.page_size | at_most: paginate.items }} of {{ paginate.items }} pieces
    </p>
    <div class="progress-bar-track">
      {%- assign progress = paginate.current_offset | plus: paginate.page_size | times: 100 | divided_by: paginate.items | at_most: 100 -%}
      <div class="progress-bar-fill" style="width: {{ progress }}%;"></div>
    </div>
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="btn-load-more">Load More Pieces</a>
    {%- endif -%}
  </div>
{%- endif -%}
